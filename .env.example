# PARTHAVI TRADE DESK PRO — server-only environment
PORT=3000
NODE_ENV=production

# Angel One SmartAPI — never commit real values
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
ANGELONE_TOTP_CODE=

# Request identity/network
ANGELONE_CLIENT_LOCAL_IP=
ANGELONE_PUBLIC_IP=
ANGELONE_MAC_ADDRESS=
ANGELONE_REGISTERED_STATIC_IPS=

# Production order gates — keep locked until independently verified
ORDER_EXECUTION_ENABLED=false
STATIC_IP_VERIFIED=false
PROTECTIVE_SL_VERIFIED=false
TRADING_KILL_SWITCH=true

# Optional independent historical-candle backup (Upstox V3).
# Keep tokens here on the server only; never commit real credentials or expose them in the frontend.
# Upstox access tokens expire at 03:30 IST the next day; renew the token when Data Health reports it invalid.
UPSTOX_ACCESS_TOKEN=
UPSTOX_NIFTY_INDEX_KEY=NSE_INDEX|Nifty 50
UPSTOX_BANKNIFTY_INDEX_KEY=NSE_INDEX|Nifty Bank
UPSTOX_FINNIFTY_INDEX_KEY=
UPSTOX_MIDCPNIFTY_INDEX_KEY=
UPSTOX_SENSEX_INDEX_KEY=
UPSTOX_VIX_INDEX_KEY=NSE_INDEX|India VIX
# To independently verify futures volume/VWAP, configure the currently active front-month futures key.
# Update the futures key at rollover; no index-volume substitution is permitted.
UPSTOX_NIFTY_FUTURES_KEY=
UPSTOX_BANKNIFTY_FUTURES_KEY=
UPSTOX_FINNIFTY_FUTURES_KEY=
UPSTOX_MIDCPNIFTY_FUTURES_KEY=

# Optional DeepSeek advisory review (disabled unless explicitly enabled).
# API key must stay server-side; never place it in the APK or public frontend.
ENABLE_DEEPSEEK_AI=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_CALLS_PER_MINUTE=4
DEEPSEEK_MAX_CALLS_PER_DAY=40

# Option engine
OPTION_STRIKE_STEP=50